<% if @order.current_step == "shopping" %>
  <div class="font-extrabold grid grid-cols-9 sticky top-0 bg-afida-green opacity-90 pt-2">
    <% Category.all.each do |category| %>
      <% category_name = category.name.downcase.gsub(" ", "_") %>
      <%= link_to "##{category_name}", class: "no-underline" do %>
        <div class="mx-auto text-center w-16">
          <div class="">
            <% if File.exist?(Rails.root.join("app/views/shared/_#{category_name}_svg.html.erb")) %>
              <%= render "shared/#{category_name}_svg" %>
            <% end %>
          </div>
          <div class="text-xs text-black py-2">
            <%= category.name %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
