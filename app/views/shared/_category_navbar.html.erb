<% if @order.current_step == "shopping" %>
  <div class="font-extrabold grid grid-cols-3 lg:grid-cols-9 sticky top-0 bg-afida-green pt-2">
    <% Category.all.each do |category| %>
      <% category_name = category.name.downcase.gsub(" ", "_") %>
      <%= link_to "##{category_name}", class: "font-impact no-underline" do %>
        <div class="mx-auto text-center w-16">
          <div class="max-lg:hidden lg:visible">
            <%= image_tag "/images/#{category_name}.svg", class: "h-6 md:h-24" %>
          </div>
          <div class="text-black py-2 text-xs">
            <%= category.name %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
