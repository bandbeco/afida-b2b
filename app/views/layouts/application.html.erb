    <main class="container mx-auto flex-grow">
      <div class="mx-auto max-w-2xl px-4 py-4 lg:max-w-7xl lg:px-8">
        <% if notice.present? %>
          <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice">
            <%= notice %>
