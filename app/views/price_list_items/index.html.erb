<% content_for :title, "Price list" %>

<div class="flex justify-between items-center">
  <h1 class="font-bold text-4xl">Price List</h1>
</div>

<div id="price_list_items" class="min-w-full">
  <% @price_list_items.each do |price_list_item| %>
    <%= render price_list_item %>
    <p>
      <%= link_to "Show this price list item", price_list_item, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    </p>
  <% end %>
</div>
