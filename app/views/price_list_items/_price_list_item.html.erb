<div class="bg-black text-white italic font-extrabold justify-between text-3xl font-impact rounded border-black border-2 p-4 my-4">
  <div>
    <h1>
      <%= price_list_item.product.name&.titleize %>
    </h1>
    <p class="py-2 text-base not-italic font-mono"><%= price_list_item.product.sku %></p>
  </div>
</div>

<div class="flex flex-row bg-white rounded">
  <div class="w-1/2">
    <% if price_list_item.product.picture.attached? %>
      <%= image_tag price_list_item.product.picture.variant(resize_and_pad: [275, 275]) %>
    <% end %>
  </div>

  <div class="flex flex-col justify-center font-mono">
    <div>
      Colour: <%= price_list_item.product.colour&.titleize %>
    </div>

    <div>
      PAC Size: <%= price_list_item.product.pac_size %>
    </div>
  </div>
</div>
