<tr id="<%= dom_id order %>" class="border-t border-gray-300">
<td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= link_to "INV000#{order.id}", order_path(order), class: "text-indigo-600 hover:text-indigo-900" %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= order.status %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= order.total_amount %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= order.shipping_address %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= order.billing_address %></td>
</tr>