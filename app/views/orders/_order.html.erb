<tr id="<%= dom_id order %>" class="border-t border-gray-300">
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= link_to order.formatted_order_id, order_path(order), class: "text-indigo-600 hover:text-indigo-900" %>
  </td>

  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= order.user.formatted_name %>
  </td>

  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= order.user.company %>
  </td>

  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= local_time(order.created_at) %>
  </td>

  <td class="whitespace-nowrap px-3 py-4 text-right text-sm text-gray-500">
    <%= currency_for(order.total_amount) %>
  </td>
</tr>
