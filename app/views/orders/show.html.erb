<main class="bg-white px-4 pb-24 pt-16 sm:px-6 sm:pt-24 lg:px-8 lg:py-32">
  <div class="mx-auto max-w-3xl">
    <div class="max-w-xl">
      <h2 class="mt-2 text-4xl font-bold tracking-tight">Order Details</h2>
    </div>

    <section aria-labelledby="order-heading" class="mt-10 border-t border-gray-200">
      <h2 id="order-heading" class="sr-only">Your order</h2>

      <h3 class="sr-only">Items</h3>

      <% @order.order_items.each do |order_item| %>
        <div class="flex space-x-6 border-b border-gray-200 py-10">
          <% if order_item.product.picture.attached? %>
            <%= image_tag order_item.product.picture, class: "h-20 w-20 flex-none rounded-lg bg-gray-100 object-cover object-center sm:h-40 sm:w-40" %>
          <% end %>

          <div class="flex flex-auto flex-col">
            <div>
              <h4 class="font-medium text-gray-900">
                <%= link_to order_item.product.name, product_path(order_item.product) %>
              </h4>
              <p class="mt-2 text-sm text-gray-600"><%= order_item.product.description %></p>
            </div>
            <div class="mt-6 flex flex-1 items-end">
              <dl class="flex space-x-4 divide-x divide-gray-200 text-sm sm:space-x-6">
                <div class="flex">
                  <dt class="font-medium text-gray-900">Quantity</dt>
                  <dd class="ml-2 text-gray-700"><%= order_item.quantity %></dd>
                </div>
                <div class="flex pl-4 sm:pl-6">
                  <dt class="font-medium text-gray-900">Price</dt>
                  <dd class="ml-2 text-gray-700"><%= currency_for(order_item.unit_price) %></dd>
                </div>
                <div class="flex pl-4 sm:pl-6">
                  <dt class="font-medium text-gray-900">Total</dt>
                  <dd class="ml-2 text-gray-700"><%= currency_for(order_item.total_price) %></dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      <% end %>

      <div class="sm:ml-40 sm:pl-6">
        <h3 class="sr-only">Your information</h3>

        <h4 class="sr-only">Addresses</h4>
        <dl class="grid grid-cols-2 gap-x-6 py-10 text-sm">
          <div>
            <dt class="font-medium text-gray-900">Shipping address</dt>
            <dd class="mt-2 text-gray-700">
              <address class="not-italic">
                <%= @order.shipping_address %>
              </address>
            </dd>
          </div>
          <div>
            <dt class="font-medium text-gray-900">Billing address</dt>
            <dd class="mt-2 text-gray-700">
              <address class="not-italic">
                <%= @order.billing_address %>
              </address>
            </dd>
          </div>
        </dl>

        <h4 class="sr-only">Payment</h4>
        <dl class="grid grid-cols-2 gap-x-6 border-t border-gray-200 py-10 text-sm">
          <div>
            <dt class="font-medium text-gray-900">Payment method</dt>
            <dd class="mt-2 text-gray-700">
              <p><%= @order.payment_method.titleize %></p>
            </dd>
          </div>

          <div>
            <dt class="font-medium text-gray-900">Shipping method</dt>
            <dd class="mt-2 text-gray-700">
              <p>DHL</p>
            </dd>
          </div>
        </dl>

        <h3 class="sr-only">Summary</h3>

        <dl class="space-y-6 border-t border-gray-200 pt-10 text-sm">
          <div class="flex justify-between">
            <dt class="font-medium text-gray-900">Subtotal</dt>
            <dd class="text-gray-700"><%= currency_for(@order.subtotal_amount) %></dd>
          </div>

          <div class="flex justify-between">
            <dt class="font-medium text-gray-900">Shipping</dt>
            <dd class="text-gray-700"><%= currency_for(@order.shipping_amount) %></dd>
          </div>

          <div class="flex justify-between">
            <dt class="font-medium text-gray-900">VAT 20%</dt>
            <dd class="text-gray-700"><%= currency_for(@order.vat_amount) %></dd>
          </div>

          <div class="flex justify-between">
            <dt class="font-medium text-gray-900">Total</dt>
            <dd class="text-gray-900"><%= currency_for(@order.total_amount) %></dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</main>
