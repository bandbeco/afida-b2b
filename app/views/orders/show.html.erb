<main class="bg-white px-4 pb-24 sm:px-6 sm:pt-24 lg:px-8 lg:py-32">
  <div class="mx-auto max-w-3xl">
    <div class="space-y-2 px-4 sm:flex sm:items-baseline sm:justify-between sm:space-y-0 sm:px-0">
      <div class="flex sm:items-baseline sm:space-x-4">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-3xl">Order #<%= @order.invoice_number %></h1>
        <% if current_user.admin? %>
          <div class="flex space-x-2">
            <%= link_to edit_order_path(@order), class: "btn btn-sm btn-outline" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
              </svg>
              Edit
            <% end %>
            <%= button_to order_path(@order), method: :delete, class: "btn btn-sm btn-error", data: { turbo_confirm: "Are you sure you want to delete this order?" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            Delete
          <% end %>
          </div>
        <% end %>
      </div>

      <p class="font-mono text-sm text-gray-600">placed <%= local_time(@order.created_at, class: "font-medium text-gray-900") %></p>
    </div>

    <div class="my-6">
      <section aria-labelledby="order-heading" class="mt-16">
        <div class="card bg-neutral text-neutral-content my-4">
          <div class="card-body p-4">
            <h1 class="card-title text-3xl font-bold italic uppercase">
              Summary
            </h1>
          </div>
        </div>

        <h2 id="order-heading" class="sr-only">Your order</h2>

        <h3 class="sr-only">Items</h3>

        <% @order.order_items.each do |order_item| %>
          <div class="flex space-x-6 border-b border-gray-200 py-10">
            <% if order_item.product.picture.attached? %>
              <div class="avatar">
                <div class="h-20 w-20 sm:h-40 sm:w-40 rounded-lg">
                  <%= image_tag order_item.product.picture, class: "object-cover object-center" %>
                </div>
              </div>
            <% end %>

            <div class="flex flex-auto flex-col">
              <div>
                <h4>
                  <%= link_to order_item.product.name, price_list_item_path(order_item.price_list_item), class: "link link-hover" %>
                </h4>

                <p class="mt-2 text-sm text-gray-600">
                  SKU: <%= order_item.product.sku %>
                </p>

                <p class="mt-2 text-sm text-gray-600">
                  Colour: <%= order_item.product.colour %>
                </p>

                <p class="mt-2 text-sm text-gray-600">
                  PAC Size: <%= order_item.product.pac_size %> pieces
                </p>
              </div>

              <div class="mt-6 flex flex-1 items-end">
                <dl class="flex space-x-4 divide-x divide-gray-200 text-sm sm:space-x-6">
                  <div class="flex">
                    <dt class="font-medium text-gray-900">Quantity</dt>
                    <dd class="ml-2 text-gray-700"><%= order_item.quantity %></dd>
                  </div>
                  <div class="flex pl-4 sm:pl-6">
                    <dt class="font-medium text-gray-900">Unit Price</dt>
                    <dd class="ml-2 text-gray-700"><%= currency_for(order_item.unit_price) %></dd>
                  </div>
                  <div class="flex pl-4 sm:pl-6">
                    <dt class="font-medium text-gray-900">Total</dt>
                    <dd class="ml-2 text-gray-700"><%= currency_for(order_item.total_price) %></dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        <% end %>

        <div class="mt-16">
          <h2 class="sr-only">Billing Summary</h2>

          <div class="bg-base-200 px-4 py-6 sm:rounded-lg sm:px-6 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8 lg:py-8">
            <dl class="grid grid-cols-2 gap-6 text-sm sm:grid-cols-2 md:gap-x-8 lg:col-span-7">
              <div>
                <dt class="font-medium text-gray-900">Billing Address</dt>
                <dd class="mt-3 text-gray-500">
                  <span class="block"><%= @order.billing_address %></span>
                </dd>
              </div>

              <div>
                <dt class="font-medium text-gray-900">Payment Method</dt>
                <dd class="mt-3 text-gray-500">
                  <span class="block"><%= @order.payment_method.gsub("_", " ") %></span>
                </dd>
              </div>

              <div>
                <dt class="font-medium text-gray-900">Shipping Address</dt>
                <dd class="mt-3 text-gray-500">
                  <span class="block"><%= @order.shipping_address %></span>
                </dd>
              </div>
            </dl>

            <div class="mt-8 lg:col-span-5 lg:mt-0">
              <div class="stats stats-vertical w-full">
                <div class="stat px-0 py-2">
                  <div class="flex items-center justify-between">
                    <div class="stat-title text-gray-600">Subtotal</div>
                    <div class="font-medium text-gray-900"><%= currency_for(@order.subtotal_amount) %></div>
                  </div>
                </div>
                <div class="stat px-0 py-2">
                  <div class="flex items-center justify-between">
                    <div class="stat-title text-gray-600">Shipping</div>
                    <div class="font-medium text-gray-900"><%= currency_for(@order.shipping_amount) %></div>
                  </div>
                </div>
                <div class="stat px-0 py-2">
                  <div class="flex items-center justify-between">
                    <div class="stat-title text-gray-600">VAT (20%)</div>
                    <div class="font-medium text-gray-900"><%= currency_for(@order.vat_amount) %></div>
                  </div>
                </div>
                <div class="stat px-0 pt-4 border-t">
                  <div class="flex items-center justify-between">
                    <div class="font-medium text-gray-900">Order total</div>
                    <div class="font-medium text-primary"><%= currency_for(@order.total_amount) %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
