<% content_for :title, "Orders" %>

<div class="bg-black text-white italic font-extrabold grid text-3xl font-impact rounded border-black border-2 p-4 my-4">
  <h1>
    ORDERS
  </h1>
</div>

<div class="flow-root">
  <div>
    <div class="inline-block min-w-full align-middle border-black border-2 rounded">
      <table class="min-w-full border-separate border-spacing-0 bg-white">
        <thead>
          <tr class="even:bg-gray-50">
            <th scope="col" class="sticky top-0 z-10 hidden border-b border-gray-300 bg-white bg-opacity-75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur backdrop-filter sm:table-cell">
              Order no.
            </th>

            <th scope="col" class="sticky top-0 z-10 hidden border-b border-gray-300 bg-white bg-opacity-75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur backdrop-filter sm:table-cell">
              Status
            </th>

            <th scope="col" class="sticky top-0 z-10 hidden border-b border-gray-300 bg-white bg-opacity-75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur backdrop-filter sm:table-cell">
              Total Amount (&pound;)
            </th>

            <th scope="col" class="sticky top-0 z-10 hidden border-b border-gray-300 bg-white bg-opacity-75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur backdrop-filter lg:table-cell">
              Shipping Address
            </th>

            <th scope="col" class="sticky top-0 z-10 border-b border-gray-300 bg-white bg-opacity-75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur backdrop-filter">
              Billing Address
            </th>
          </tr>
        </thead>

        <tbody>
          <% @orders.each do |order| %>
            <%= render order %>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>
