<%= form_with(model: order, class: "space-y-8") do |form| %>
  <% if order.errors.any? %>
    <div class="alert alert-error mb-6">
      <div class="flex">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="ml-3">
          <h3 class="font-bold">
            <%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:
          </h3>
          <div class="text-sm">
            <ul class="list-disc pl-5 space-y-1">
              <% order.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100">
    <div class="card-body">
      <h3 class="card-title">Order Details</h3>

      <div class="space-y-6">
        <div class="form-control w-full">
          <%= form.label :payment_method, class: "label" %>
          <div class="mt-1">
            <%= form.select :payment_method,
                Order.payment_methods.keys.map { |p| [p.titleize, p] },
                {},
                class: "select select-bordered w-full" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div class="form-control">
            <%= form.label :shipping_address, class: "label" %>
            <div class="mt-1">
              <%= form.text_area :shipping_address,
                  rows: 4,
                  class: "textarea textarea-bordered w-full",
                  placeholder: "Enter shipping address details..." %>
            </div>
          </div>

          <div class="form-control">
            <%= form.label :billing_address, class: "label" %>
            <div class="mt-1">
              <%= form.text_area :billing_address,
                  rows: 4,
                  class: "textarea textarea-bordered w-full",
                  placeholder: "Enter billing address details..." %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
