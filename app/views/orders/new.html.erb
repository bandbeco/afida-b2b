<%= form_with(model: @order, data: { turbo: false }) do |form| %>
  <%= render "#{@order.current_step}_step", form: form %>

  <div class="my-5">
    <p>
      <% if @order.last_step? %>
        <%= form.submit "Submit Order", class: "block bg-blue-500 text-white rounded-md px-3 py-2 mt-2 w-full" %>
      <% else %>
        <%= form.submit "Continue", class: "block bg-blue-500 text-white rounded-md px-3 py-2 mt-2 w-full" %>
      <% end %>
    </p>

    <p>
      <%= form.submit "Back", class: "block bg-blue-500 text-white rounded-md px-3 py-2 mt-2 w-full", name: "back_button" unless @order.first_step? %>
    </p>
  </div>
<% end %>
