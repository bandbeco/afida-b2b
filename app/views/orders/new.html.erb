<%= form_with(model: @order, data: { turbo: false }) do |form| %>
  <% if @order.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2>
        <%= pluralize(@order.errors.count, "error") %> prohibited this order from being saved:
      </h2>

      <ul>
        <% @order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "#{@order.current_step}_step", form: form, products: @products %>

  <div class="my-5">
    <% if @order.last_step? %>
      <%= form.submit "Submit Order", class: "block bg-blue-500 text-white rounded-md px-3 py-2 mt-2 w-full" %>
    <% else %>
      <%= form.submit "Continue", class: "block bg-blue-500 text-white rounded-md px-3 py-2 mt-2 w-full" %>
    <% end %>
  </div>
<% end %>
