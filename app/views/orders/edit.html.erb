<main class="bg-white px-4 pb-24 sm:px-6 sm:pt-24 lg:px-8 lg:py-32">
  <div class="mx-auto max-w-3xl">
    <div class="space-y-2 px-4 sm:flex sm:items-baseline sm:justify-between sm:space-y-0 sm:px-0">
      <div class="flex sm:items-baseline sm:space-x-4">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-3xl">Edit Order #<%= @order.invoice_number %></h1>
      </div>

      <div class="flex space-x-2">
        <%= link_to order_path(@order), class: "btn btn-sm btn-outline" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Back to Order
        <% end %>
      </div>
    </div>

    <div class="mt-8">
      <%= render "form", order: @order %>
    </div>
  </div>
</main>
