<h3 class="font-semibold text-xl">Confirm your order</h3>

<div class="my-5">
  <h4 class="font-semibold text-md">Shipping Address</h4>
  <%= @order.shipping_address %>
  <%= form.hidden_field :shipping_address, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full" %>
</div>

<div class="my-5">
  <h4 class="font-semibold text-md">Billing Address</h4>
  <%= @order.billing_address %>
  <%= form.hidden_field :billing_address, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full" %>
</div>
