<div class="bg-white">
  <!-- Background color split screen for large screens -->
  <div class="fixed left-0 top-0 hidden h-full w-1/2 bg-afida-green lg:block" aria-hidden="true"></div>
  <div class="fixed right-0 top-0 hidden h-full w-1/2 bg-white lg:block" aria-hidden="true"></div>

  <header class="relative mx-auto max-w-7xl bg-afida-green py-6 lg:grid lg:grid-cols-2 lg:gap-x-16 lg:bg-transparent lg:px-8 lg:pb-10 lg:pt-16">
    <div class="mx-auto flex max-w-2xl px-4 lg:w-full lg:max-w-lg lg:px-0">
      <%= render "shared/logo" %>
    </div>
  </header>

  <main class="relative mx-auto grid max-w-7xl grid-cols-1 gap-x-16 lg:grid-cols-2 lg:px-8">
    <h1 class="sr-only">Checkout</h1>

    <section aria-labelledby="summary-heading" class="bg-afida-green pb-12 pt-6 md:px-10 lg:col-start-2 lg:row-start-1 lg:mx-auto lg:w-full lg:max-w-lg lg:bg-transparent lg:px-0 lg:pb-24 lg:pt-0">
      <div class="mx-auto max-w-2xl px-4 lg:max-w-none lg:px-0">
        <h2 id="summary-heading" class="sr-only">Order summary</h2>

        <dl>
          <dt class="text-sm font-medium">Amount due</dt>
          <dd class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
            <%= currency_for(@order.total_amount) %>
          </dd>
        </dl>

        <ul role="list" class="divide-y divide-gray-900 divide-opacity-10 text-sm font-medium">
          <% @order.order_items.each do |order_item| %>
            <li class="flex items-start space-x-4 py-6">
              <% if order_item.product.picture.attached? %>
                <%= image_tag order_item.product.picture.variant(resize_and_pad: [150, 150]), class: "h-20 w-20 flex-none rounded-md object-cover object-center" %>
              <% end %>

              <div class="flex-auto space-y-1">
                <h3><%= order_item.product.name %></h3>
                <p><%= order_item.product.colour %></p>
                <p>Quantity: <%= order_item.quantity %></p>
                <p>Unit price: &pound;<%= order_item.unit_price %></p>
                <p>Subtotal: &pound;<%= order_item.quantity * order_item.unit_price %></p>

              </div>
              <p class="flex-none text-base font-medium"></p>
            </li>
          <% end %>
        </ul>

        <dl class="space-y-6 border-t border-black pt-6 text-sm font-medium">
          <div class="flex items-center justify-between">
            <dt>Subtotal</dt>
            <dd><%= currency_for(@order.subtotal_amount) %></dd>
          </div>

          <div class="flex items-center justify-between">
            <dt>Shipping</dt>
            <dd><%= currency_for(@order.shipping_amount) %></dd>
          </div>

          <div class="flex items-center justify-between">
            <dt>VAT 20%</dt>
            <dd><%= currency_for(@order.vat_amount) %></dd>
          </div>

          <div class="flex items-center justify-between border-t-2 border-black pt-6">
            <dt class="text-base">Total</dt>
            <dd class="text-base">
              <%= currency_for(@order.total_amount) %>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section aria-labelledby="payment-and-shipping-heading" class="py-16 lg:col-start-1 lg:row-start-1 lg:mx-auto lg:w-full lg:max-w-lg lg:pb-24 lg:pt-0">
      <h2 id="payment-and-shipping-heading" class="sr-only">Payment and shipping details</h2>

      <div class="mx-auto max-w-2xl px-4 lg:max-w-none lg:px-0">
        <div class="mt-10 pb-4">
          <h3 id="payment-heading" class="text-lg font-medium text-gray-900">Payment method</h3>

          <div class="mt-6 grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-4">
            <div class="col-span-3 sm:col-span-4">
              <div class="mt-1">
                <fieldset>
                  <div class="space-y-4">
                    <div class="flex items-center">
                      <%= form.radio_button :payment_method, :invoice, checked: true, class: "h-4 w-4 border-gray-300 focus:ring-indigo-600" %>
                      <%= form.label :payment_method_invoice, "Invoice", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
                    </div>

                    <div class="flex items-center">
                      <%= form.radio_button :payment_method, :bank_transfer, class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                      <%= form.label :payment_method_bank_transfer, "Bank Transfer", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 pb-4">
          <h3 class="text-lg font-medium text-gray-900">Shipping address</h3>

          <div class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-3">
            <%= form.fields_for :shipping_address do |shipping_address| %>
              <div class="sm:col-span-3">
                <%= shipping_address.label :company, "Company", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :company, value: current_user.company, autocomplete: "organization", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div class="sm:col-span-3">
                <%= shipping_address.label :attn, "Attention Of", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :attn, value: current_user.formatted_name, autocomplete: "organization", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div class="sm:col-span-3">
                <%= shipping_address.label :street_number_and_name, "Address", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :street_number_and_name, autocomplete: "street-address", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div>
                <%= shipping_address.label :post_town, "City", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :post_town, autocomplete: "address-level2", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div>
                <%= shipping_address.label :postcode, "Postcode", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :postcode, autocomplete: "postal-code", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div class="sm:col-span-3">
                <%= shipping_address.label :additional_notes, "Additional Notes", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1">
                  <%= shipping_address.text_field :additional_notes, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-10 pb-4">
        <h3 class="text-lg font-medium text-gray-900">Billing address</h3>

        <div class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-3">
          <%= form.fields_for :billing_address do |billing_address| %>
            <div class="sm:col-span-3">
              <%= billing_address.label :company, "Company", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= billing_address.text_field :company, value: current_user.company, autocomplete: "organization", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div class="sm:col-span-3">
              <%= billing_address.label :street_number_and_name, "Address", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= billing_address.text_field :street_number_and_name, autocomplete: "street-address", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= billing_address.label :post_town, "City", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= billing_address.text_field :post_town, autocomplete: "address-level2", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= billing_address.label :postcode, "Postcode", class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-1">
                <%= billing_address.text_field :postcode, autocomplete: "postal-code", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-10 flex justify-end pt-6">
        <%= form.submit "Submit Order", class: "btn-primary" %>
      </div>

    </section>
  </main>
</div>
