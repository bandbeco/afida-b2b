<% content_for :title, "Addresses" %>

<div class="bg-black text-white italic font-extrabold grid text-3xl font-impact rounded border-black border-2 p-4 my-4">
  <h1>
    ADDRESSES
  </h1>
</div>

<div class="flex justify-between items-center">
  <%= link_to "New address", new_address_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
</div>

<div id="addresses" class="min-w-full">
  <% @addresses.each do |address| %>
    <%= render address %>
    <p>
    <%= link_to "Show this address", address, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    </p>
  <% end %>
</div>
