<div id="<%= dom_id address %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Building name:</strong>
    <%= address.building_name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Street number and name:</strong>
    <%= address.street_number_and_name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Post town:</strong>
    <%= address.post_town %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Postcode:</strong>
    <%= address.postcode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Additional notes:</strong>
    <%= address.additional_notes %>
  </p>

</div>
