<%= turbo_frame_tag "order_form_frame" do %>
  <section class="mx-auto w-full max-w-xl">
    <%= form_with(model: @order, data: { controller: 'address-selection',
                                         address_selection_addresses_value: @addresses.to_json(only: [:id, :company, :attn, :building_name, :street_number_and_name, :post_town, :postcode, :additional_notes]),
                                         address_selection_default_shipping_id_value: @default_shipping_address&.id,
                                         address_selection_default_billing_id_value: @default_billing_address&.id,
                                         turbo: false }) do |form| %>
      <div class="mx-auto">
        <% if @order.errors.any? %>
          <div class="alert alert-error mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <h3 class="font-medium"><%= pluralize(@order.errors.count, "error") %> prohibited this order from being saved</h3>
              <ul class="list-disc ml-5 mt-1 text-sm">
                <% @order.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <!-- Payment Method Section -->
        <div class="card bg-base-100 border border-base-200 mb-6">
          <div class="card-body p-6">
            <h2 class="text-lg font-medium flex items-center mb-4 text-base-content">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              Payment Method
            </h2>
            
            <div class="form-control">
              <div class="flex flex-col gap-2">
                <label class="label cursor-pointer justify-start gap-3 py-2">
                  <%= form.radio_button :payment_method, :invoice, checked: true, class: "radio radio-primary" %>
                  <span class="label-text">Invoice</span>
                </label>
                <label class="label cursor-pointer justify-start gap-3 py-2">
                  <%= form.radio_button :payment_method, :bank_transfer, class: "radio radio-primary" %>
                  <span class="label-text">Bank Transfer</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Shipping Address Section -->
        <div class="card bg-base-100 border border-base-200 mb-6">
          <div class="card-body p-6">
            <h2 class="text-lg font-medium flex items-center mb-4 text-base-content">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Shipping Address
            </h2>
            
            <div class="form-control w-full mb-4">
              <label class="label">
                <span class="label-text font-medium">Select a Shipping Address</span>
              </label>

              <% shipping_options = options_for_select([["-- Enter New Address --", "new"]]) %>
              <% shipping_options = options_from_collection_for_select(@addresses, :id, :formatted_address, @order.selected_shipping_address_id).concat(shipping_options) %>

              <div class="relative">
                <%= form.select :selected_shipping_address_id,
                                shipping_options,
                                {},
                                { class: "select select-bordered w-full h-12 focus:outline-primary bg-base-100 text-base-content",
                                  data: { action: "change->address-selection#selectShippingAddress" } } %>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <div data-address-selection-target="shippingFields">
              <div class="divider text-sm text-base-content/70">Enter a new address</div>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Company</span>
                    </label>
                    <%= form.text_field :shipping_company, autocomplete: "organization", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingCompany" } %>
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Attention Of</span>
                    </label>
                    <%= form.text_field :shipping_attn, autocomplete: "name", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingAttn" } %>
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Building Name</span>
                      <span class="label-text-alt">Optional</span>
                    </label>
                    <%= form.text_field :shipping_building_name, class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingBuildingName" } %>
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Address</span>
                    </label>
                    <%= form.text_field :shipping_street_number_and_name, autocomplete: "street-address", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingStreet" } %>
                  </div>
                </div>

                <div>
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">City</span>
                    </label>
                    <%= form.text_field :shipping_post_town, autocomplete: "address-level2", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingCity" } %>
                  </div>
                </div>

                <div>
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Postcode</span>
                    </label>
                    <%= form.text_field :shipping_postcode, autocomplete: "postal-code", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingPostcode" } %>
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text font-medium">Additional Notes</span>
                    </label>
                    <%= form.text_area :shipping_additional_notes, rows: 3, class: "textarea textarea-bordered w-full bg-base-100 text-base-content", data: { address_selection_target: "shippingNotes" } %>
                  </div>
                </div>
              </div>

              <div class="form-control mt-4" data-address-selection-target="saveShippingCheckboxContainer">
                <label class="label cursor-pointer justify-start gap-3">
                  <%= form.check_box :save_shipping_address, { class: "checkbox checkbox-primary" }, "1", "0" %>
                  <span class="label-text">Save this address to my address book</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Billing Address Section -->
        <div class="card bg-base-100 border border-base-200 mb-6">
          <div class="card-body p-6">
            <h2 class="text-lg font-medium flex items-center mb-4 text-base-content">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Billing Address
            </h2>

            <div class="form-control mb-4">
              <label class="label cursor-pointer justify-start gap-3">
                <%= form.check_box :use_shipping_for_billing, { data: { action: "change->address-selection#toggleBillingFields" }, class: "checkbox checkbox-primary" }, "1", "0" %>
                <span class="label-text">Same as shipping address</span>
              </label>
            </div>

            <div data-address-selection-target="billingSection">
              <div class="form-control w-full mb-4">
                <label class="label">
                  <span class="label-text font-medium">Select Billing Address</span>
                </label>

                <% billing_options = options_for_select([["-- Enter New Address --", "new"]]) %>
                <% billing_options = options_from_collection_for_select(@addresses, :id, :formatted_address, @order.selected_billing_address_id).concat(billing_options) %>

                <div class="relative">
                  <%= form.select :selected_billing_address_id,
                                  billing_options,
                                  {},
                                  { class: "select select-bordered w-full h-12 focus:outline-primary bg-base-100 text-base-content",
                                    data: { action: "change->address-selection#selectBillingAddress" } } %>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>
              </div>

              <div data-address-selection-target="billingFields">
                <div class="divider text-sm text-base-content/70">Enter a new address</div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <div class="sm:col-span-2">
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">Company</span>
                      </label>
                      <%= form.text_field :billing_company, autocomplete: "organization", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "billingCompany" } %>
                    </div>
                  </div>

                  <div class="sm:col-span-2">
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">Building Name</span>
                        <span class="label-text-alt">Optional</span>
                      </label>
                      <%= form.text_field :billing_building_name, class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "billingBuildingName" } %>
                    </div>
                  </div>

                  <div class="sm:col-span-2">
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">Address</span>
                      </label>
                      <%= form.text_field :billing_street_number_and_name, autocomplete: "street-address", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "billingStreet" } %>
                    </div>
                  </div>

                  <div>
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">City</span>
                      </label>
                      <%= form.text_field :billing_post_town, autocomplete: "address-level2", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "billingCity" } %>
                    </div>
                  </div>

                  <div>
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">Postcode</span>
                      </label>
                      <%= form.text_field :billing_postcode, autocomplete: "postal-code", class: "input input-bordered h-12 w-full bg-base-100 text-base-content", data: { address_selection_target: "billingPostcode" } %>
                    </div>
                  </div>

                  <div class="sm:col-span-2">
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text font-medium">Additional Notes</span>
                      </label>
                      <%= form.text_area :billing_additional_notes, rows: 3, class: "textarea textarea-bordered w-full bg-base-100 text-base-content", data: { address_selection_target: "billingNotes" } %>
                    </div>
                  </div>
                </div>

                <div class="form-control mt-4" data-address-selection-target="saveBillingCheckboxContainer">
                  <label class="label cursor-pointer justify-start gap-3">
                    <%= form.check_box :save_billing_address, { class: "checkbox checkbox-primary" }, "1", "0" %>
                    <span class="label-text">Save this address to my address book</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex justify-end pt-6 m-4">
          <%= form.submit "Submit Order", class: "btn btn-primary px-8" %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
