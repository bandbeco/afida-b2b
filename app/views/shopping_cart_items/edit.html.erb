<div class="mx-auto md:w-2/3 w-full">
  <div class="card bg-neutral text-neutral-content mb-6">
    <div class="card-body p-4">
      <h1 class="card-title text-3xl font-bold">Editing shopping cart item</h1>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%= turbo_frame_tag @shopping_cart_item do %>
        <%= render "form", shopping_cart_item: @shopping_cart_item %>
      <% end %>
      
      <div class="card-actions mt-4 flex gap-2">
        <%= link_to "Show this shopping cart item", @shopping_cart_item, class: "btn btn-outline" %>
        <%= link_to "Back to shopping cart items", shopping_cart_items_path, class: "btn btn-outline" %>
      </div>
    </div>
  </div>
</div>
