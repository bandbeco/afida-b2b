<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing shopping cart item</h1>

  <%= turbo_frame_tag @shopping_cart_item do %>
    <%= render "form", shopping_cart_item: @shopping_cart_item %>
  <% end %>

  <%= link_to "Show this shopping cart item", @shopping_cart_item, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
  <%= link_to "Back to shopping cart items", shopping_cart_items_path, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
</div>
