<div class="card bg-base-100 shadow-sm mt-10 pb-4">
  <div class="card-body">
    <h3 class="card-title">Shipping address</h3>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <%= form.fields_for :shipping_address do |shipping_address| %>
        <div class="form-control sm:col-span-3">
          <%= shipping_address.label :street_number_and_name, "Address", class: "label" %>
          <%= shipping_address.text_field :street_number_and_name, autocomplete: "street-address", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= shipping_address.label :post_town, "City", class: "label" %>
          <%= shipping_address.text_field :post_town, autocomplete: "address-level2", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= shipping_address.label :postcode, "Postcode", class: "label" %>
          <%= shipping_address.text_field :postcode, autocomplete: "postal-code", class: "input input-bordered w-full" %>
        </div>

        <div class="form-control sm:col-span-3">
          <%= shipping_address.label :additional_notes, "Additional Notes", class: "label" %>
          <%= shipping_address.text_field :additional_notes, class: "input input-bordered w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
