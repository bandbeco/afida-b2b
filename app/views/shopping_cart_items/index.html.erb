<%= render "shopping_cart", shopping_cart: @shopping_cart %>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <%= render partial: "shopping_cart_item", collection: @shopping_cart_items %>
</div>

<div class="mt-12">
  <div class="card bg-neutral text-neutral-content mb-8">
    <div class="card-body p-4">
      <h2 id="checkout" class="card-title text-3xl font-bold italic uppercase">
        CHECKOUT
      </h2>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 lg:grid-cols-2 lg:pt-4">
    <%= render "order_summary", checkout: Checkout.new(current_user.shopping_cart) %>
    <%= render "order_form" %>
  </div>
</div>
