<div id="shopping_cart_items_count" class="font-mono bg-black text-white font-extrabold grid grid-cols-2 font-impact rounded border-black border-2 p-4 justify-center">
  <div>
    <a href="#checkout" class="group -m-2 flex items-center p-2 no-underline">
      <svg class="h-6 w-6 flex-shrink-0 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
      <span class="ml-2 text-sm font-medium text-white">
        <%= shopping_cart.shopping_cart_items.added_to_cart.sum(:quantity) %>
      </span>
    </a>
  </div>

  <div class="text-right">

    <a href="#checkout" class="btn-primary">Checkout</a>
  </div>
</div>
