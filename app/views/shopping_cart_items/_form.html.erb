<%= form_with(model: shopping_cart_item, class: "contents") do |form| %>
  <% if shopping_cart_item.errors.any? %>
    <div id="error_explanation" class="alert alert-error mt-3">
      <div>
        <h2><%= pluralize(shopping_cart_item.errors.count, "error") %> prohibited this shopping_cart_item from being saved:</h2>
        <ul>
          <% shopping_cart_item.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control my-5">
    <%= form.label :cart_id, class: "label" %>
    <%= form.text_field :cart_id, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :product_id, class: "label" %>
    <%= form.text_field :product_id, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :quantity, class: "label" %>
    <%= form.number_field :quantity, class: "input input-bordered w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
