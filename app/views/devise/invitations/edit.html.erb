<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <%= render "shared/logo" %>
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900"><%= t "devise.invitations.edit.header" %></h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm card shadow-xl bg-base-100 p-8">
    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :invitation_token, readonly: true %>

      <% if f.object.class.require_password_on_accepting %>
        <div class="form-control w-full">
          <div class="label">
            <%= f.label :password, class: "label-text" %>
          </div>
          <%= f.password_field :password, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control w-full">
          <div class="label">
            <%= f.label :password_confirmation, class: "label-text" %>
          </div>
          <%= f.password_field :password_confirmation, class: "input input-bordered w-full" %>
        </div>
      <% end %>

      <div class="form-control mt-6">
        <%= f.submit t("devise.invitations.edit.submit_button"), class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
