<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <%= render "shared/logo" %>
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900"><%= t "devise.invitations.new.header" %></h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm card shadow-xl bg-base-100 p-8">
    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <% resource.class.invite_key_fields.each do |field| -%>
        <div class="form-control w-full">
          <div class="label">
            <%= f.label field, class: "label-text" %>
          </div>
          <%= f.text_field field, class: "input input-bordered w-full" %>
        </div>
      <% end -%>

      <div class="form-control mt-6">
        <%= f.submit t("devise.invitations.new.submit_button"), class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
