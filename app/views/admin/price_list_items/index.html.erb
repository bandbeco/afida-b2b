<%= form_with(model: [:admin, @user], data: { turbo: false }) do |form| %>
  <% if @user.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2>
        <%= pluralize(@user.errors.count, "error") %> prohibited this price list from being saved:
      </h2>

      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% @categorized_price_list_items.each do |category, price_list_items| %>
    <div class="bg-black text-white italic font-extrabold grid text-3xl font-impact rounded border-black border-2 p-4 my-4">
      <h2>
        <%= category.name.upcase %>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
      <% price_list_items.each do |price_list_item| %>
        <%= form.fields_for :price_list_items, price_list_item do |f| %>
          <div class="group bg-white rounded border-black border-2">
            <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden">
              <% if f.object.product.picture.attached? %>
                <%= image_tag f.object.product.picture, class: "h-full w-full object-center group-hover:opacity-75" %>
              <% end %>
            </div>

            <div class="p-3 text-gray-700">
              <h3 class="mt-2 font-medium"><%= f.object.product.name %> (<%= f.object.product.pac_size %> pcs)</h3>

              <p class="mt-4 block text-sm font-medium leading-6 text-gray-900">List Price: <%= currency_for(f.object.product.price) %></p>

              <div class="mt-4">
                <label for="price" class="block text-sm font-medium leading-6 text-gray-900">Customer Price:</label>
                <div class="relative mt-2 rounded-md shadow-sm">
                  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <span class="text-gray-500 sm:text-sm">&pound;</span>
                  </div>

                  <%= f.text_field :price, min: 0, value: number_with_precision(f.object.price, precision: 2), class: "block w-full rounded-md border-0 py-1.5 pl-7 pr-12 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
                </div>

                <div class="mt-4 relative flex items-start">
                  <div class="flex h-6 items-center">
                    <%= f.check_box :hidden, checked: f.object.hidden?, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                  </div>

                  <div class="ml-3 text-sm leading-6">
                    <% f.label :hidden, class: "font-medium text-gray-900" %>
                    <span class="font-medium text-gray-900">Hidden from customer</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= form.submit "Save Changes", class: "btn btn-primary" %>
  </div>
<% end %>
