<tr id="<%= dom_id price_list_item %>" class="border-t border-gray-300">
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.sku&.upcase %></td>
  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-3"><%= price_list_item.product.name&.titleize %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.colour&.titleize %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.pac_size %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.width_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.depth_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.height_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= price_list_item.product.price %></td>
  </td>
</tr>
