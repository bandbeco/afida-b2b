<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic uppercase">
      Addresses for <%= @user.formatted_name %>
    </h1>
    <p class="text-sm opacity-80"><%= @user.email %></p>
  </div>
</div>

<div class="flex justify-end mb-4">
  <%= link_to new_admin_user_address_path(@user), class: "btn btn-primary gap-2" do %>
    Add Address
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
    </svg>
  <% end %>
</div>

<div class="card bg-base-100 shadow-xl">
  <div class="card-body p-0">
    <% if @addresses.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Company</th>
              <th>Address</th>
              <th>Postcode</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @addresses.each do |address| %>
              <tr>
                <td><%= address.company %></td>
                <td><%= address.street_number_and_name %>, <%= address.post_town %></td>
                <td><%= address.postcode %></td>
                <td class="text-right">
                  <%= link_to 'Edit', edit_admin_user_address_path(@user, address), class: "btn btn-ghost btn-sm" %>
                  <%= link_to 'Delete', admin_user_address_path(@user, address), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-error btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-4">
        <p>This user has no addresses yet.</p>
      </div>
    <% end %>
  </div>
</div>