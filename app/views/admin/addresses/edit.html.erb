<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-gray-800 mb-6">Edit Address for <%= @user.email %></h1>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <%= render 'form', address: @address %>
  </div>

  <%= link_to 'Back to Addresses', admin_user_addresses_path(@user), class: "link" %>
</div>
