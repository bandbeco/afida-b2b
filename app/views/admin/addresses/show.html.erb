<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic uppercase">
      Address Details for <%= @user.formatted_name %>
    </h1>
  </div>
</div>

<div class="card w-full md:w-2/3 bg-base-100 shadow-xl mx-auto">
  <div class="card-body">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="stat p-0">
        <div class="stat-title">Company</div>
        <div class="stat-value text-lg"><%= @address.company %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Attention</div>
        <div class="stat-value text-lg"><%= @address.attn.presence || '-' %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Building Name</div>
        <div class="stat-value text-lg"><%= @address.building_name.presence || '-' %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Street & Number</div>
        <div class="stat-value text-lg"><%= @address.street_number_and_name %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Town/City</div>
        <div class="stat-value text-lg"><%= @address.post_town %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Postcode</div>
        <div class="stat-value text-lg"><%= @address.postcode %></div>
      </div>
      <div class="md:col-span-2 stat p-0">
        <div class="stat-title">Additional Notes</div>
        <div class="stat-value text-lg whitespace-pre-wrap"><%= @address.additional_notes.presence || '-' %></div>
      </div>
    </div>

    <div class="card-actions justify-end mt-6 gap-2">
      <%= link_to 'Edit', edit_admin_user_address_path(@user, @address), class: "btn btn-primary" %>
      <%= link_to 'Back to Addresses', admin_user_addresses_path(@user), class: "btn btn-ghost" %>
    </div>
  </div>
</div>
