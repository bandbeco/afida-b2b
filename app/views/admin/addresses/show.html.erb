<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold text-gray-800 mb-6">Address Details for <%= @user.email %></h1>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Company</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.company %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Attention</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.attn.presence || '-' %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Building Name</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.building_name.presence || '-' %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Street & Number</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.street_number_and_name %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Town/City</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.post_town %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Postcode</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.postcode %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-gray-500">Additional Notes</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @address.additional_notes.presence || '-' %></dd>
      </div>
    </dl>
  </div>

  <div class="mt-6 flex space-x-3">
    <%= link_to 'Edit', edit_user_address_path(@user, @address), class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to 'Back to Addresses', user_addresses_path(@user), class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
