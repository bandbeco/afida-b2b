<div class="bg-black text-white italic font-extrabold grid grid-cols-2 justify-between text-3xl font-impact rounded border-black border-2 p-4 my-4">
  <div>
    <h1>
      <%= @product.name&.titleize %>
    </h1>
    <p class="py-2 text-base not-italic font-mono"><%= @product.sku %></p>
  </div>

  <div class="text-right">
    <%= link_to "Edit Product", edit_product_path(@product), class: "btn btn-primary" %>
  </div>
</div>

<div class="flex flex-row bg-white rounded">
  <div class="w-1/2">
    <% if @product.picture.attached? %>
      <%= image_tag @product.picture, class: "h-full w-full object-center group-hover:opacity-75" %>
    <% end %>
  </div>

  <div class="text-xl flex flex-col justify-center font-mono">
    <div>
      Price: <%= currency_for(@product.price) %>
    </div>

    <div>
      PAC Size: <%= @product.pac_size %>
    </div>

    <div>
      Colour: <%= @product.colour&.titleize %>
    </div>
  </div>
</div>

<div class="mt-8 bg-white rounded shadow-md p-6">
  <h2 class="text-xl font-semibold mb-4">Who can see this product in their price list?</h2>

  <%= form_with url: update_visibility_admin_product_path(@product), method: :patch, class: "mb-4", data: { controller: "visibility" } do |form| %>
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>
              <div class="flex items-center gap-2">
                <input type="checkbox" id="select-all" class="checkbox" data-action="change->visibility#toggleAll" />
                <label for="select-all" class="cursor-pointer">Select All</label>
              </div>
            </th>
            <th>User</th>
            <th>Company</th>
            <th>Custom Price</th>
            <th>Current Status</th>
          </tr>
        </thead>
        <tbody>
          <% @price_list_items.each do |item| %>
            <tr>
              <td>
                <%= check_box_tag "visible_user_ids[]", item.user.id, !item.hidden?, 
                    class: "checkbox", 
                    data: { 
                      visibility_target: "checkbox",
                      action: "change->visibility#updateSelectAll" 
                    } 
                %>
              </td>
              <td><%= item.user.formatted_name %></td>
              <td><%= item.user.company %></td>
              <td><%= currency_for(item.price) %></td>
              <td>
                <% if item.hidden? %>
                  <span class="badge badge-error">Hidden</span>
                <% else %>
                  <span class="badge badge-success">Visible</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <%= form.submit "Save Visibility Changes", 
                     class: "btn btn-disabled opacity-50 cursor-not-allowed",
                     data: { visibility_target: "saveButton" },
                     disabled: true %>
    </div>
  <% end %>
</div>