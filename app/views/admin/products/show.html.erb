<div class="bg-black text-white italic font-extrabold grid grid-cols-2 justify-between text-3xl font-impact rounded border-black border-2 p-4 my-4">
  <div>
    <h1>
      <%= @product.name&.titleize %>
    </h1>
    <p class="py-2 text-base not-italic font-mono"><%= @product.sku %></p>
  </div>

  <div class="text-right">
    <%= link_to "Edit Product", edit_product_path(@product), class: "btn btn-primary" %>
  </div>
</div>

<div class="flex flex-col bg-white rounded p-4">
  <h2 class="text-xl font-semibold mb-4">Who can see this product in their price list?</h2>

  <%= form_with url: update_visibility_admin_product_path(@product), method: :patch, class: "mb-4", data: { controller: "visibility" }, html: { autocomplete: "off" } do |form| %>
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full border-2 border-black">
        <thead class="bg-black text-white">
          <tr>
            <th>User</th>
            <th>Company</th>
            <th>Custom Price</th>
            <th>
              <div class="flex items-center gap-2">
                <input type="checkbox" id="select-all" class="checkbox bg-white checked:bg-white" data-action="change->visibility#toggleAll" />
                <label for="select-all" class="cursor-pointer text-white">Hidden</label>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @price_list_items.each do |item| %>
            <tr>
              <td><%= link_to item.user.formatted_name, edit_admin_user_path(item.user) %></td>
              <td><%= item.user.company %></td>
              <td><%= currency_for(item.price) %></td>
              <td>
                <%= check_box_tag "visible_user_ids[]", item.user.id, !item.hidden?,
                    id: "visibility_checkbox_#{item.id}",
                    class: "checkbox",
                    data: {
                      visibility_target: "checkbox",
                      action: "change->visibility#updateSelectAll"
                    }
                %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex justify-end">
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>