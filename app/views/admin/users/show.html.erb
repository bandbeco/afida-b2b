<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <div class="card bg-base-100 shadow-xl mb-4">
      <div class="card-body">
        <%= render @user %>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit this user", edit_admin_user_path(@user), class: "btn btn-primary" %>
      <%= link_to "Back to users", admin_users_path, class: "btn btn-outline" %>
      <%= button_to "Destroy this user", [:admin, @user], method: :delete, class: "btn btn-error", data: { turbo_confirm: 'Are you sure you want to delete this user?' } %>
    </div>
  </div>
</div>
