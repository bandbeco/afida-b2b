<div class="card w-full md:w-2/3 bg-base-100 shadow-xl mx-auto">
  <div class="card-body">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h2 class="card-title text-2xl"><%= @user.formatted_name %></h2>
        <p class="text-sm text-base-content text-opacity-60"><%= @user.email %></p>
        <p class="text-sm text-base-content text-opacity-60"><%= @user.company %></p>
      </div>
      <div class="badge badge-lg badge-outline"><%= @user.role %></div>
    </div>

    <div class="mt-4 space-y-2">
       <div class="stat p-0">
        <div class="stat-title">Invitation Status</div>
        <div class="stat-value text-lg">
          <% if @user.invitation_accepted? %>
            Accepted on <%= local_time(@user.invitation_accepted_at, format: :short) %>
          <% elsif @user.invited_to_sign_up? %>
            Invited on <%= local_time(@user.invitation_sent_at, format: :short) %> (Pending)
          <% else %>
            Not Invited
          <% end %>
        </div>
      </div>
       <div class="stat p-0">
        <div class="stat-title">Addresses</div>
        <div class="stat-value text-lg">
          <%= link_to pluralize(@user.addresses.count, 'Address'), admin_user_addresses_path(@user), class: "link link-primary", data: { turbo: false } %>
        </div>
      </div>
       <div class="stat p-0">
        <div class="stat-title">Price List</div>
        <div class="stat-value text-lg">
          <% if @user.price_list_items.any? %>
            <%= link_to "View Price List", admin_user_price_list_items_path(@user), class: "link link-primary", data: { turbo: false } %>
          <% else %>
            <span class="text-base-content text-opacity-60">No custom prices</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card-actions justify-end mt-6 gap-2">
      <%= link_to "Edit", edit_admin_user_path(@user), class: "btn btn-primary" %>
      <%= link_to "Back to Users", admin_users_path, class: "btn btn-ghost" %>
      <%= button_to "Delete User", [:admin, @user], method: :delete, class: "btn btn-error", data: { turbo_confirm: 'Are you sure you want to delete this user?' } %>
    </div>
     <%= render "invitation_email_button" if current_user.admin? && !@user.invitation_accepted? %>
  </div>
</div>
