<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic mb-2">
      <%= @user.formatted_name %>
    </h1>

    <% if @user.accepted_invitation? %>
      <p class="text-xs font-mono">
        Joined on <%= local_time(@user.invitation_accepted_at) %>
      </p>
    <% end %>
  </div>
</div>

<div class="md:w-1/3 w-full">
  <%= render "form", user: @user %>
  <%= render "invitation_email_button" if current_user.admin? %>
</div>

<div class="divider py-8">Stats</div>

<% if (top_products = @user.most_ordered_products).any? %>
  <div class="card bg-base-100 shadow-xl my-6">
    <div class="card-body">
      <h2 class="card-title text-xl">Top <%= top_products.size %> Most Frequently Ordered Products</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2">
        <% top_products.each_with_index do |product_data, index| %>
          <div class="flex items-start gap-3 p-3 bg-base-200 rounded-lg">
            <div class="badge badge-lg"><%= index + 1 %></div>
            <div class="flex-grow">
              <% if product_data[:product].picture.attached? %>
                <div class="avatar mb-2">
                  <div class="w-12 h-12 rounded">
                    <%= image_tag product_data[:product].picture, class: "object-cover" %>
                  </div>
                </div>
              <% end %>
              <p class="font-semibold text-sm"><%= product_data[:product].name %></p>
              <p class="text-xs">SKU: <%= product_data[:product].sku %></p>
              <p class="text-xs mt-1">Ordered in <%= pluralize(product_data[:frequency], 'order') %></p>
              <p class="text-xs text-gray-500">Quantity: <%= product_data[:total_quantity] %> units</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="divider py-8">Past Orders</div>

<div class="mt-8">
  <% if @user.orders.any? %>
    <div class="overflow-x-auto">
      <table class="table w-full bg-white">
        <thead>
          <tr>
            <th>Invoice No.</th>
            <th>Date</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @user.orders.order(created_at: :desc).each do |order| %>
            <tr>
              <td><%= link_to order.invoice_number, order, class: "link" %></td>
              <td><%= local_time(order.created_at, format: :short) %></td>
              <td><%= number_to_currency(order.total_amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>This user has no orders yet.</p>
  <% end %>
</div>
