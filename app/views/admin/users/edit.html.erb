<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic mb-2">
      <%= @user.formatted_name %>
    </h1>

    <% if @user.accepted_invitation? %>
      <p class="text-xs font-mono">
        Joined on <%= local_time(@user.invitation_accepted_at) %>
      </p>
    <% end %>
  </div>
</div>

<div class="md:w-1/3 w-full">
  <%= render "form", user: @user %>
  <%= render "invitation_email_button" if current_user.admin? %>
</div>

<div class="divider py-8">Past Orders</div>

<div class="mt-8">
  <% if @user.orders.any? %>
    <div class="overflow-x-auto">
      <table class="table w-full bg-white">
        <thead>
          <tr>
            <th>Invoice No.</th>
            <th>Date</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @user.orders.order(created_at: :desc).each do |order| %>
            <tr>
              <td><%= link_to order.invoice_number, order, class: "link" %></td>
              <td><%= local_time(order.created_at, format: :short) %></td>
              <td><%= number_to_currency(order.total_amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>This user has no orders yet.</p>
  <% end %>
</div>
