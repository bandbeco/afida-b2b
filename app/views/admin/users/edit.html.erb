<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic mb-2">
      <%= @user.formatted_name %>
    </h1>

    <p class="text-xs font-mono">
      Joined on <%= local_time(@user.invitation_accepted_at) if @user.accepted_invitation? %>
    </p>

    <div class="card-actions justify-end mt-4">
      <%= link_to 'Manage Addresses', user_addresses_path(@user), class: "btn btn-sm btn-outline" %>
    </div>
  </div>
</div>

<div class="md:w-1/3 w-full">
  <%= render "form", user: @user %>
  <%= render "invitation_email_button" if current_user.admin? %>
</div>
