<tr id="<%= dom_id user %>">
  <td>
    <%= link_to user.formatted_name, edit_user_path(user), class: "link link-hover" %>
  </td>

  <td>
    <%= user.company %>
  </td>

  <td>
    <%= user.email %>
  </td>

  <td>
    <%= user.role %>
  </td>

  <td>
    <%= form_for(user, url: invitation_path(user), html: { method: :post }) do |f| %>
      <%= f.hidden_field :user_id, value: user.id %>
      <% if user.invited? && !user.invitation_accepted? %>
        <%= f.submit "Resend Invitation", class: "btn btn-primary btn-sm" %>
      <% elsif !user.invited? %>
        <%= f.submit "Send Invitation", class: "btn btn-primary btn-sm" %>
      <% else %>
      <% end %>
    <% end %>
  </td>

  <td>
    <% if user.price_list_items.any? %>
      <%= link_to "Price List", user_price_list_items_path(user), class: "link link-primary" %>
    <% end %>
  </td>
</tr>
