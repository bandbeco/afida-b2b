<div data-controller="order-item" class="group bg-white rounded border-black border-2 flex flex-col text-center">
  <% picture = price_list_item.product.picture %>
  <% if current_user.admin? %>
    <%= link_to product_path(price_list_item.product) do %>
      <%= image_tag picture.variant(resize_and_pad: [275, 275]) if picture.attached? %>
    <% end %>
  <% else %>
    <%= image_tag picture.variant(resize_and_pad: [275, 275]) if picture.attached? %>
  <% end %>

  <div class="p-3 text-gray-700">
    <h3 class="mt-2 font-medium">
      <%= price_list_item.product.name %>
    </h3>

    <div class="text-sm mb-4 flex justify-evenly">
      <p class="mt-1">
        <%= currency_for(price_list_item.price) %> / <%= price_list_item.product.pac_size %> pcs
      </p>
    </div>

    <%= form.hidden_field :product_id %>
    <%= form.hidden_field :unit_price %>

    <div class="flex justify-center mt-4 font-mono">
      <%= button_tag "Decrement",
        type: "button",
        data: { action: "click->order-item#decrement" },
        class: "flex-shrink-0 bg-gray-100 hover:bg-gray-200 inline-flex items-center justify-center border border-gray-300 rounded-md h-10 w-10 focus:ring-gray-100 focus:ring-2 focus:outline-none" do %>
        <svg class="w-3.5 h-2.5 text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 2">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h16"/>
        </svg>
      <% end %>

      <%= form.number_field :quantity,
        min: 0,
        value: 0,
        class: "border border-gray-400 flex-shrink-0 text-gray-900 rounded-md text-xl max-w-[3.5rem] text-center mx-4 p-0",
        data: {
          order_item_target: "quantity"
        }
      %>

    <%= button_tag "Increment",
      type: "button",
      data: { action: "click->order-item#increment" },
      class: "flex-shrink-0 bg-gray-100 hover:bg-gray-200 inline-flex items-center justify-center border border-gray-300 rounded-md h-10 w-10 focus:ring-gray-100 focus:ring-2 focus:outline-none" do %>
      <svg class="w-3.5 h-3.5 text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 1v16M1 9h16"/>
      </svg>
    <% end %>
    </div>

  </div>
</div>
