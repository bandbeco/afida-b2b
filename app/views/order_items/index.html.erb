<% content_for :title, "Order items" %>

<div class="flex justify-between items-center">
  <h1 class="font-bold text-4xl">Order items</h1>
  <%= link_to "New order item", new_order_item_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
</div>

<div id="order_items" class="min-w-full">
  <% @order_items.each do |order_item| %>
    <%= render order_item %>
    <p>
    <%= link_to "Show this order item", order_item, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    </p>
  <% end %>
</div>
