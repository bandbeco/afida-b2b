<div class="card lg:card-side bg-base-100 shadow-xl my-4">
  <% if @product.picture.attached? %>
    <figure class="lg:w-1/2">
      <%= image_tag @product.picture, class: "object-cover h-full w-full" %>
    </figure>
  <% end %>
  <div class="card-body <%= 'lg:w-1/2' if @product.picture.attached? %>">
    <div class="flex justify-between items-start">
      <div>
        <h2 class="card-title text-2xl"><%= @product.name&.titleize %></h2>
        <p class="text-sm text-base-content text-opacity-60"><%= @product.sku %></p>
      </div>
      <div class="card-actions justify-end">
        <%= link_to "Edit", edit_product_path(@product), class: "btn btn-primary" %>
      </div>
    </div>

    <div class="mt-4 space-y-2">
      <div class="stat p-0">
        <div class="stat-title">Price</div>
        <div class="stat-value text-lg"><%= currency_for(@product.price) %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">PAC Size</div>
        <div class="stat-value text-lg"><%= @product.pac_size %></div>
      </div>
      <div class="stat p-0">
        <div class="stat-title">Colour</div>
        <div class="stat-value text-lg"><%= @product.colour&.titleize %></div>
      </div>
      <% if @product.description.present? %>
        <div class="pt-4">
          <h3 class="font-semibold mb-1">Description</h3>
          <p class="text-base-content text-opacity-80"><%= @product.description %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
