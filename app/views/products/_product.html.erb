<div id="<%= dom_id product %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Sku:</strong>
    <%= product.sku %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= product.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Colour:</strong>
    <%= product.colour %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Pac size:</strong>
    <%= product.pac_size %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Price:</strong>
    <%= product.price %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Width in mm:</strong>
    <%= product.width_in_mm %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Height in mm:</strong>
    <%= product.height_in_mm %>
  </p>

</div>
