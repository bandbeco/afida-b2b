<tr id="<%= dom_id product %>">
  <td>
    <% if product.picture.attached? %>
      <div class="avatar">
        <div class="mask mask-squircle w-12 h-12">
          <%= image_tag product.picture.variant(resize_and_pad: [100, 100]) %>
        </div>
      </div>
    <% end %>
  </td>
  <td><%= product.sku&.upcase %></td>
  <td>
    <% if current_user&.admin? %>
      <%= link_to product.name&.titleize, admin_product_path(product), data: { turbo: false }, class: "link link-hover" %>
    <% else %>
      <%= product.name&.titleize %>
    <% end %>
  </td>
  <td class="hidden lg:table-cell"><%= product.colour&.titleize %></td>
  <td><%= product.pac_size %></td>
  <td><%= currency_for(product.price) %></td>
</tr>
