<tr id="<%= dom_id product %>" class="border-t border-gray-300">
  <td class="whitespace-nowrap px-3 py-4">
    <% if product.picture.attached? %>
      <%= image_tag product.picture.variant(resize_to_limit: [150, nil]), class: "h-full w-full object-cover object-center sm:h-full sm:w-full" %>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.sku&.upcase %></td>
  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-3">
    <%= link_to product.name&.titleize, product %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.colour&.titleize %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.pac_size %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.width_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.depth_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.height_in_mm %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= product.price %></td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
    <%= link_to "Edit", edit_product_path(product), class: "block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
  </td>
</tr>
