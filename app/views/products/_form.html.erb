<%= form_with(model: product, class: "contents") do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation" class="alert alert-error mt-3">
      <div>
        <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>
        <ul>
          <% product.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-control my-5">
    <%= form.label :sku, "SKU", class: "label" %>
    <%= form.text_field :sku, class: "input input-bordered w-full", 'aria-readonly' => true %>
  </div>

  <div class="form-control my-5">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :category_id, "Category", class: "label" %>
    <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, class: "select select-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :picture, class: "label" %>
    <%= form.file_field :picture, class: "file-input file-input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :description, class: "label" %>
    <%= form.text_area :description, rows: 4, class: "textarea textarea-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :colour, class: "label" %>
    <%= form.text_field :colour, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :pac_size, "PAC Size", class: "label" %>
    <%= form.number_field :pac_size, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :price, class: "label" %>
    <%= form.text_field :price, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :width_in_mm, class: "label" %>
    <%= form.number_field :width_in_mm, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :depth_in_mm, class: "label" %>
    <%= form.number_field :depth_in_mm, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :height_in_mm, class: "label" %>
    <%= form.number_field :height_in_mm, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :volume_in_ml, class: "label" %>
    <%= form.number_field :volume_in_ml, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control my-5">
    <%= form.label :diameter_in_mm, class: "label" %>
    <%= form.number_field :diameter_in_mm, class: "input input-bordered w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
