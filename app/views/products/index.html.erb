<% content_for :title, "Products" %>

<div class="card bg-neutral text-neutral-content my-4">
  <div class="card-body p-4">
    <h1 class="card-title text-3xl font-bold italic uppercase">
      PRODUCTS
    </h1>
  </div>
</div>

<div class="flex justify-between items-center mb-4 gap-4">
  <%= form_with url: products_path, method: :get, data: { controller: "search-form", turbo_frame: "products_list" }, class: "flex-grow max-w-2xl" do |form| %>
    <label class="input input-bordered flex items-center gap-2">
      <%= form.text_field :query,
        value: params[:query],
        placeholder: "Search by name or SKU",
        class: "grow",
        type: "search",
        data: { action: "input->search-form#search" } %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4 opacity-70"><path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" /></svg>
    </label>
  <% end %>

  <div>
    <%= link_to new_product_path, class: "btn btn-primary gap-2" do %>
      New product
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "products_list" do %>
  <div class="mt-8 flow-root">
    <div>
      <div class="inline-block min-w-full align-middle">
        <div class="overflow-x-auto">
          <table class="table table-zebra bg-base-300">
            <thead>
              <tr class="bg-base-200">
                <th></th>
                <th>SKU</th>
                <th class="hidden sm:table-cell">Name</th>
                <th class="hidden lg:table-cell">Colour</th>
                <th>PAC Size</th>
                <th>Catalog Price</th>
              </tr>
            </thead>
            <tbody class="bg-base-100">
              <% @products.each do |product| %>
                <%= render product %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
